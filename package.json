{
  "name": "mizan-amil",
  "version": "1.0.0",
  "private": true,
  "description": "Mizan Amil — kalkulator zakat dan simulasi pengelolaan zakat, media pembelajaran Hukum Zakat HES FAI UMS",
  "scripts": {
